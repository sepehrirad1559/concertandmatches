# Environment
NODE_ENV=development
LOG_LEVEL=info

# API Server
API_PORT=3000
API_HOST=localhost

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=eventflow
DB_PASSWORD=eventflow
DB_NAME=eventflow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Source API Keys
TICKETMASTER_API_KEY=your_api_key_here
EVENTBRITE_API_KEY=your_api_key_here
STUBHUB_API_KEY=your_api_key_here

# Affiliate Config
TICKETMASTER_AFFILIATE_ID=your_affiliate_id
EVENTBRITE_AFFILIATE_ID=your_affiliate_id

# JWT (for future admin authentication)
JWT_SECRET=your_jwt_secret_change_in_production

# Crawler Config
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT_MS=10000
FRESHNESS_THRESHOLD_MINUTES=30

# Features
ENABLE_ELASTICSEARCH_SYNC=true
ENABLE_PRICE_TRACKING=true
ENABLE_ANOMALY_DETECTION=true

# Email (for future alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# Monitoring
SENTRY_DSN=

# Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_in_production
